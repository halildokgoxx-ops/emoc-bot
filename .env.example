# BOT TOKEN (https://discord.com/developers/applications -> Bot -> Token)
TOKEN=buraya_tokenini_yapistir
# Komut ön eki
PREFIX=!
# Bot sahibi ID (isteğe bağlı, eval/sunucu-vitrin onayı için)
OWNER_ID=
# Uygulama (Client) ID — slash komutlar için ZORUNLU
CLIENT_ID=
# --- WEB PANEL (OAuth2) ---
# Developer Portal → OAuth2 → Client Secret (Reveal yapıp al)
CLIENT_SECRET=buraya_client_secret
# Sitenin adresi (Render URL'in: https://emoc-xxxx.onrender.com)
BASE_URL=http://localhost:3000
# --- KÖPRÜ MODU (bot başka yerde, panel Render'da) ---
# UZUN rastgele yazı üret (örn: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Botun .env'i + Render env'i BİREBİR aynı olmalı!
BRIDGE_SECRET=buraya_uzun_rastgele_yazi
# Sadece panele (Render): botun herkese açık adresi (örn: https://bot.ornek.com)
BOT_API_URL=https://botun-adresi.ornek.com
